# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 마세요(.gitignore에 이미 포함됨).

# ── PostgreSQL 연결 (사내 서버 10.10.70.115) ──
PGHOST=10.10.70.115
PGPORT=5432
# 개발 중에는 hr_cx_manage_de, 운영 전환 시 hr_cx_manage
PGDATABASE=hr_cx_manage_de
# pgAdmin4에서 이 DB 전용으로 새로 만든 최소권한 role(예: hr_cx_manage_app) — postgres 슈퍼유저나
# 다른 프로젝트와 공용으로 쓰는 계정을 쓰지 마세요. db/create_role.sql 참고.
PGUSER=hr_cx_manage_app
PGPASSWORD=여기에_실제_비밀번호
# 사내망 내부 연결이라면 보통 false, 서버가 TLS를 요구하면 true
PGSSL=false
PG_POOL_MAX=15

# ── 세션 ──
# 반드시 무작위 값으로 교체: 터미널에서 `openssl rand -hex 32` 또는 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=여기에_무작위_긴_문자열
# https 리버스프록시 뒤에 있으면 true. 사내망 http 직접 서비스면 false.
COOKIE_SECURE=false

# ── CORS ──
# gwangjae_v222.html이 실제 서비스되는 도메인(들), 쉼표로 구분. 확정 전에는 로컬 테스트용 주소만.
ALLOWED_ORIGINS=http://localhost:5500

# ── 접근 제어: 사내망 IP 대역 밖 차단 ──
# '회사 와이파이/사내망'으로 인정해서 접속을 허용할 IP 대역(CIDR), 쉼표로 여러 개 지정 가능.
# 이 대역 밖에서 오는 요청은 화면 로딩부터 API까지 전부 403으로 막힌다. 비워두면 막지 않음.
# localhost(127.0.0.1/::1)와 GAS_API_KEY로 인증된 서버-서버 호출(구글 클라우드에서 옴)은 항상 예외.
ALLOWED_NETWORKS=10.10.0.0/16

# ── 서버 ──
PORT=4000
JSON_BODY_LIMIT=20mb

# ── GAS(Google Apps Script) 연동용 API 키 ──
# 브라우저 없이 서버-서버로 호출하는 GAS 스크립트(gas_*.js)가 세션 쿠키 대신 이 키로 인증한다.
# 무작위로 하나 만들어서 여기 넣고, 같은 값을 GAS 프로젝트의 스크립트 속성(GAS_API_KEY)에도
# 등록해야 한다: 터미널에서 `openssl rand -hex 32` 또는
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
GAS_API_KEY=여기에_무작위_긴_문자열
